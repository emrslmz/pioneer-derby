{
  "name": "pioneer-derby",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:fix:*\"",
    "lint:fix:oxlint": "oxlint . --fix",
    "lint:fix:eslint": "eslint . --fix --cache",
    "lint:check": "oxlint . && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "simulate": "tsx scripts/simulate.ts",
    "report:traceability": "tsx scripts/traceability.ts",
    "verify": "run-s lint:check format:check type-check \"test:unit --run\"",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "visual:pull": "bash scripts/pull-visual-baselines.sh",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "test:lighthouse": "lhci autorun",
    "media": "tsx scripts/capture-media.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "driver.js": "^1.4.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.23"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "fast-check": "^4.10.3",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "sass": "^1.108.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "description": "Pioneer Derby \u2014 horse racing game for the Insider One front-end case"
}
